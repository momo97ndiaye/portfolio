---
// Hero — geometric grid bg, glow, animated badge, dual CTA
---

<section id="hero" class="relative flex items-center justify-center hero-grid overflow-hidden pt-16 pb-20 min-h-[90vh]">

  <!-- Glow orbs in background -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[600px] h-[400px] rounded-full opacity-10"
         style="background:radial-gradient(ellipse, #38BDF8 0%, transparent 70%); filter:blur(60px);"></div>
    <div class="absolute bottom-1/3 left-1/4 w-80 h-80 rounded-full opacity-6"
         style="background:radial-gradient(ellipse, #6366F1 0%, transparent 70%); filter:blur(80px);"></div>
  </div>

  <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">

    <!-- Animated availability badge -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass badge-pulse mb-8"
         style="border:1px solid rgba(56,189,248,0.3);"
         data-aos="fade-down" data-aos-delay="100">
      <span class="w-2 h-2 rounded-full bg-[#38BDF8] animate-pulse"></span>
      <span class="text-[#38BDF8] text-sm font-medium" data-i18n="hero.badge">Disponible pour nouveaux projets ✦</span>
    </div>

    <!-- Name -->
    <h1 class="text-5xl sm:text-6xl md:text-7xl font-extrabold leading-tight mb-4 glow-cyan"
        style="font-family:'Bricolage Grotesque',sans-serif;"
        data-aos="fade-up" data-aos-delay="200">
      <span class="gradient-text">Mamadou NDIAYE</span>
    </h1>

    <!-- Subtitle -->
    <p class="text-xl sm:text-2xl text-[#94A3B8] font-mono mb-6"
       data-aos="fade-up" data-aos-delay="300">
      <span data-i18n="hero.subtitle">FullStack Engineer & SaaS Builder</span>
    </p>

    <!-- Description -->
    <p class="text-base sm:text-lg text-[#64748B] max-w-2xl mx-auto mb-10 leading-relaxed"
       data-aos="fade-up" data-aos-delay="400">
      <span data-i18n="hero.description">4 ans d'expérience sur des projets à fort impact institutionnel — ministères, collectivités, PME. Forte sensibilité UI/UX, exécution rapide, et utilisation quotidienne de l'IA pour livrer plus vite sans sacrifier la qualité.</span>
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12"
         data-aos="fade-up" data-aos-delay="500">
      <a href="#services" class="btn-primary w-full sm:w-auto text-center" data-i18n="hero.cta_primary">
        Voir mes services
      </a>
      <a href="#contact" class="btn-outline w-full sm:w-auto text-center" data-i18n="hero.cta_secondary">
        Discutons de votre projet
      </a>
    </div>

    <!-- Location -->
    <div class="flex items-center justify-center gap-2 text-[#475569] text-sm"
         data-aos="fade-up" data-aos-delay="600">
      <span>📍</span>
      <span data-i18n="hero.location">Dakar, Sénégal · Remote</span>
    </div>
  </div>

</section>
