---
// Stats bar — chiffres clés, juste après le Hero
const stats = [
  { value: "4",   suffix: " ans",  labelKey: "stats.experience", labelFR: "d'expérience" },
  { value: "5",   suffix: "+",     labelKey: "stats.projects",   labelFR: "projets livrés" },
  { value: "2",   suffix: "",      labelKey: "stats.countries",  labelFR: "pays" },
  { value: "3",   suffix: "",      labelKey: "stats.languages",  labelFR: "langues" },
];
---

<div class="relative py-12 px-6" style="background:rgba(56,189,248,0.03); border-top:1px solid rgba(255,255,255,0.04); border-bottom:1px solid rgba(255,255,255,0.04);">
  <div class="max-w-4xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-8">
    {stats.map((s, i) => (
      <div class="flex flex-col items-center text-center gap-1" data-aos="fade-up" data-aos-delay={String(i * 80 + 100)}>
        <span class="text-4xl font-extrabold gradient-text" style="font-family:'Bricolage Grotesque',sans-serif;">
          {s.value}<span class="text-2xl">{s.suffix}</span>
        </span>
        <span class="text-sm text-[#64748B]" data-i18n={s.labelKey}>{s.labelFR}</span>
      </div>
    ))}
  </div>
</div>
