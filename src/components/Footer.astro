---
// Footer — 3-column, social icons
---

<footer class="py-10 px-6 border-t border-[rgba(255,255,255,0.06)]">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">

      <!-- Left: name + title -->
      <div class="text-center md:text-left">
        <span class="text-sm font-medium text-[#94A3B8]" data-i18n="footer.name">
          Mamadou NDIAYE · FullStack Engineer & SaaS Builder
        </span>
      </div>

      <!-- Center: copyright -->
      <div class="text-center">
        <span class="text-sm text-[#475569] font-mono" data-i18n="footer.copy">© 2026 · Dakar, Sénégal</span>
      </div>

      <!-- Right: social icons -->
      <div class="flex items-center gap-4">
        <!-- GitHub -->
        <a href="https://github.com/momo97ndiaye" target="_blank" rel="noopener noreferrer"
           class="text-[#475569] hover:text-[#38BDF8] transition-colors" aria-label="GitHub">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
